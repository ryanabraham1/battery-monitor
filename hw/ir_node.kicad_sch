	(text "BLOCK 1 High-current path: battery / bolt-down fuse / shunt / charger relay / 120 A pulse load"
		(exclude_from_sim no)
		(at 18 17.5 0)
		(effects
			(font
				(size 2.6 2.6)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5c8247d5-1332-5f09-b89b-f5e44a44d554")
	)
	(text "REV B, 120 A PULSE. BATT+ ring terminal and one end of a bolt-down MIDI fuse (60 A, off-board part) share stud J1; the other fuse end bolts to J14.\nJ14 -> R1 0.5 mOhm shunt -> VNODE. Q1 switches the off-board ~0.1 Ohm load (LOAD+/LOAD-) right next to the BATT- lug. D2 freewheels the load leads,\nC18 and D3 absorb battery-lead inductance at turn-off. Charger joins VNODE through K1 normally-closed contact and its own 10 A fuse F1, so an\nunpowered node leaves the charger CONNECTED."
		(exclude_from_sim no)
		(at 18 23 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "d02b2c2b-6ecf-543b-b7d1-c414772f4592")
	)
