	(text "BLOCK 3 Logic supply: reverse-polarity diode, 3V3 buck, gate-drive rail"
		(exclude_from_sim no)
		(at 18 207.75 0)
		(effects
			(font
				(size 2.6 2.6)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "717b215f-7ca9-505e-9ef7-3a4b88620b03")
	)
	(text "D4 = reverse-polarity protection for logic. D5 lets USB power the MCU on the bench. U4 fixed 3.3 V buck, 3.8-32 V in. VDRV = zener-clamped 12 V rail\nfor the gate driver. A normally-closed thermostat on the load resistor plugs into J13 and breaks that rail when hot, so no pulse can fire. R11 (not\nfitted) bypasses it for bench work."
		(exclude_from_sim no)
		(at 18 213.25 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "f45bf7db-8a84-5de5-8970-230c4b19de80")
	)
