	(text "BLOCK 4 Pulse-load gate drive with hardware one-shot timeout (~220 ms)"
		(exclude_from_sim no)
		(at 18 316.25 0)
		(effects
			(font
				(size 2.6 2.6)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "105d5abb-88a9-55aa-b836-30c5397dec97")
	)
	(text "LOAD_EN (GPIO6, pulled low) drives B and /CLR of the one-shot: Q follows LOAD_EN but is forced low after t = R14*C10 ~ 220 ms even if firmware hangs\nwith the pin high. U6 UVLO + R13 keep Q1 off at boot. R12 = 470 R slows the gate so 120 A is switched over ~10 us instead of <1 us."
		(exclude_from_sim no)
		(at 18 321.75 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "5b41b0ee-e8b0-5e20-80d5-54f2f332ea7d")
	)
