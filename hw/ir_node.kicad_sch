	(text "BLOCK 6 CAN bus (2x RJ45 daisy-chain, CiA-303 pinout, jumper termination) + optional NFC header"
		(exclude_from_sim no)
		(at 428 17.5 0)
		(effects
			(font
				(size 2.6 2.6)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "fd5283b9-279e-57fc-a70f-07e959f9d345")
	)
	(text "RJ45 pin 1 = CAN_H, 2 = CAN_L, 3 & 7 = GND (CiA 303-1). Both jacks are paralleled for daisy-chain. Fit JP1 on the two end nodes only. J11 takes an\noptional PN532 NFC reader (3V3, I2C1, IRQ, RST)."
		(exclude_from_sim no)
		(at 428 23 0)
